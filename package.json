{
  "name": "babin-rentals-sticker-app",
  "private": true,
  "version": "0.1.0",
  "description": "Babin Rentals sticker design, queue, and print desktop app",
  "author": "Babin Rentals",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "vitest run",
    "desktop:start": "npm run build && electron .",
    "desktop:mac": "npm run build && electron-builder --mac --dir",
    "desktop:mac:dmg": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.70.0",
    "papaparse": "^5.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.babinrentals.stickerapp",
    "productName": "Babin Rentals Sticker App",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
